# EC2에서: cp .env.prod.example .env 후 값을 바꾸세요. .env는 git에 올라가지 않습니다.
DB_NAME=purchase
DB_USERNAME=purchase
DB_PASSWORD=바꾸세요-긴-임의-문자열
DB_ROOT_PASSWORD=바꾸세요-다른-긴-임의-문자열

# 사용자가 한 명도 없을 때만 admin 계정을 이 비밀번호(8자 이상)로 만듭니다. 로그인해서 바꾼 뒤 지워도 됩니다.
ADMIN_INITIAL_PASSWORD=

# 포트폴리오 공개 데모라면 true: 샘플 계정(dev1, devlead … 비밀번호 pass1234)과 문서를 넣습니다.
# true면 ADMIN_INITIAL_PASSWORD는 쓰이지 않고 샘플 admin(pass1234)이 생깁니다.
SAMPLE_DATA=false

# 국세청 사업자 상태조회 'Decoding' 키 (비워 두면 '확인 안 됨')
NTS_SERVICE_KEY=

# 이미지 주소 (보통 그대로)
APP_IMAGE=ghcr.io/ikyoon0619/purchase-approval:latest
